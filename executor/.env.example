# Copy to .env and fill in. Never commit .env, never paste its contents in a chat.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# 1 = Binance futures testnet (fake money), 0 = real account
BINANCE_TESTNET=0
# 1 = simulate only (no orders), 0 = place real orders
DRY_RUN=1
# Leave empty to follow the engine on the dashboard (coin list, risk per trade, max positions)
SYMBOLS=
RISK_PCT=
MAX_POSITIONS=
# Optional emergency brake: no new entries while the futures wallet is below this many USDT.
# Empty = off (the backtest has no brake). Open trades are always still managed.
MIN_BALANCE=
DASHBOARD_URL=https://trading-dashboard-two-orcin.vercel.app
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
