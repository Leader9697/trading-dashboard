# Copy to .env and fill in. Never commit .env.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# 1 = Binance futures testnet (fake money), 0 = real account
BINANCE_TESTNET=0
# 1 = simulate only (no orders), 0 = place real orders
DRY_RUN=1
RISK_PCT=1
MAX_LOSSES_PER_DAY=3
# BTC is left out: its 100 USDT minimum order is too big for a small account at 1% risk
SYMBOLS=ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
DASHBOARD_URL=https://trading-dashboard-two-orcin.vercel.app
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
