# Salin ke backend/.env lalu isi seperlunya. Semua opsional.

# Daftar ticker di bar watchlist (ticker BEI pakai akhiran .JK)
WATCHLIST=BBCA.JK,BBRI.JK,TLKM.JK,AAPL,NVDA

# demo | yfinance | dsa. Kosong = dsa jika DSA_URL diisi, selain itu yfinance.
DATA_MODE=

# Server daily_stock_analysis (python main.py --serve-only), contoh http://localhost:8000
DSA_URL=

# Bridge dexter untuk riset mendalam (Tahap 3), contoh http://localhost:8787
DEXTER_URL=
