# Salin ke backend/.env lalu isi seperlunya. Semua opsional.

# Pair Binance (USDT) di tabel ringkasan
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT

# binance (data live, default) | demo (data sintetis, tanpa internet)
DATA_MODE=binance

# Connection string Edge Config tempat debat AI disimpan.
# Di Vercel otomatis terisi saat store Edge Config disambungkan ke project.
EDGE_CONFIG=

# Telegram signal alerts (optional). Token from @BotFather; leave the chat id empty to use
# whoever last messaged the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EQUITY=55
ALERT_RISK_PCT=1
